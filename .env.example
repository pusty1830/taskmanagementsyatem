# ---------- Backend ----------
# Enables /seed and /dev routes only when set to "development".
APP_ENV=development
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://taskapp:taskapp@localhost:5432/taskapp
REDIS_URL=redis://localhost:6379
# redis | memory  (memory = per-process cache, see docs/06-caching.md)
CACHE_BACKEND=redis
CACHE_TTL_SECONDS=300
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_MINUTES=60
OTP_SECRET=change-me-another-long-random-string-32-chars
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
RUST_LOG=info,task_api=debug,tower_http=info

# ---------- Postgres (docker compose) ----------
POSTGRES_USER=taskapp
POSTGRES_PASSWORD=taskapp
POSTGRES_DB=taskapp
# Host ports published by docker compose (change if already in use on your machine;
# keep DATABASE_URL / REDIS_URL above in sync for native runs).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
